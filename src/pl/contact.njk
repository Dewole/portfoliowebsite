---
layout: base.pl.njk
eleventyComputed:
  title: "Kontakt — {{ sitePl.name }}"
  description: "{{ sitePl.contactIntro }}"
---
{% import "icons.njk" as icons %}
<section class="contact-hero" id="s1">
  <div class="wrap contact-grid">
    <div>
      <div class="pill"><span class="dot-live"></span> {{ sitePl.availabilityStatus }}</div>
      <h1 class="big split-title">{{ sitePl.contactHeading }}</h1>
      <p class="lede reveal">{{ sitePl.contactIntro }}</p>
      <p class="contact-email reveal">Możesz też napisać bezpośrednio na <a href="mailto:{{ sitePl.email }}">{{ sitePl.email }}</a></p>
      <img class="photo-block tall reveal" src="{{ sitePl.profilePhoto | default('/assets/images/profile.jpg') }}" alt="{{ sitePl.name }}">
    </div>
    <form class="contact-form reveal" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact">
      <p class="hp"><label>Nie wypełniaj tego pola: <input name="bot-field"></label></p>
      <label>Imię
        <input type="text" name="name" required>
      </label>
      <label>Email
        <input type="email" name="email" required>
      </label>
      <label>Wiadomość
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button type="submit" class="btn solid cta-wide"><span class="btn-label">Wyślij wiadomość</span><span class="btn-icon arrow">{{ icons.up_right() | safe }}</span></button>
    </form>
  </div>
</section>
