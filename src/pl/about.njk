---
layout: base.pl.njk
---
{% import "icons.njk" as icons %}
{% set ctaHref = sitePl.aboutCtaButtonLink | absoluteUrl if (sitePl.aboutCtaButtonLink and not (sitePl.aboutCtaButtonLink | first == "/")) else (sitePl.aboutCtaButtonLink or "/pl/contact/") %}
<section class="about-hero" id="s1">
  <div class="wrap">
    <div class="kicker">{{ sitePl.aboutKicker or "O MNIE" }}</div>
    <h1 class="big split-title">{{ sitePl.aboutPageHeading or sitePl.aboutHeading }}</h1>
    <p class="lede reveal">{{ sitePl.aboutPageIntro or sitePl.aboutParagraph }}</p>
  </div>
</section>

<section class="about" id="s2">
  <div class="wrap about-grid">
    <div>
      {% if sitePl.aboutPhotos and sitePl.aboutPhotos.length %}
      <div class="photo-stack" id="photoStack">
        {% for ph in sitePl.aboutPhotos %}
        <figure class="photo-stack-item" data-pos="{{ loop.index0 if loop.index0 < 5 else 'x' }}">
          <img src="{{ ph.src }}" alt="{{ ph.alt or sitePl.name }}" {% if ph.position %}style="object-position:{{ ph.position }}" {% endif %}loading="{{ 'eager' if loop.first else 'lazy' }}" draggable="false">
        </figure>
        {% endfor %}
        {% if sitePl.aboutPhotos.length > 1 %}<button type="button" class="photo-stack-next" aria-label="Pokaż następne zdjęcie"><span aria-hidden="true">↻</span></button>{% endif %}
      </div>
      {% else %}
      <img class="photo-block tall reveal" src="{{ sitePl.profilePhoto | default('/assets/images/profile.jpg') }}" {% if sitePl.profilePhotoPosition %}style="object-position:{{ sitePl.profilePhotoPosition }}" {% endif %}alt="{{ sitePl.name }}">
      {% endif %}
    </div>
    <div>
      <div class="kicker">{% if sitePl.aboutBioKicker %}{{ sitePl.aboutBioKicker }}{% else %}{{ sitePl.name }} · {{ sitePl.role }}{% endif %}</div>
      {% if sitePl.aboutBio and sitePl.aboutBio.length %}<div class="lede about-bio rich-text reveal">{{ sitePl.aboutBio | portableText | safe }}</div>{% else %}<p class="lede reveal">{{ sitePl.aboutBioLong }}</p>{% endif %}
      <a href="/pl/contact/" class="btn solid reveal"><span class="btn-label">{{ sitePl.aboutContactLabel or "Napisz do mnie" }}</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
    </div>
  </div>
</section>

{%- if sitePl.showHowIWork != false %}
<section class="how-i-work" id="s3">
  <div class="wrap">
    <div class="kicker">{{ sitePl.howIWorkKicker or "PROCES" }}</div>
    <h2 class="big split-title">{{ sitePl.howIWorkHeading }}</h2>
    <p class="lede reveal">{{ sitePl.howIWorkIntro }}</p>
    <div class="how-grid">
      <div class="how-card reveal">
        <div class="service-icon how-icon">
          {% if sitePl.howIWorkStep1Icon %}<img src="{{ sitePl.howIWorkStep1Icon }}" alt="" width="40" height="40" loading="lazy">{% else %}<svg viewBox="0 0 256 256"><path d="M192,112a80,80,0,1,1-80-80A80,80,0,0,1,192,112Z" fill="var(--accent)"/><path d="M229.66,218.34,179.6,168.28a88.21,88.21,0,1,0-11.32,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" fill="var(--accent-2)"/></svg>{% endif %}
        </div>
        <span class="num">01</span>
        <h3>{{ sitePl.howIWorkStep1Title }}</h3>
        <p>{{ sitePl.howIWorkStep1Desc }}</p>
      </div>
      <div class="how-card reveal">
        <div class="service-icon how-icon">
          {% if sitePl.howIWorkStep2Icon %}<img src="{{ sitePl.howIWorkStep2Icon }}" alt="" width="40" height="40" loading="lazy">{% else %}<svg viewBox="0 0 256 256"><path d="M128,48,68.32,70.38a8,8,0,0,0-5.08,6.17L40,216l139.45-23.24a8,8,0,0,0,6.17-5.08L208,128Zm-4,104a20,20,0,1,1,20-20A20,20,0,0,1,124,152Z" fill="var(--accent)"/><path d="M248,92.68a15.86,15.86,0,0,0-4.69-11.31L174.63,12.68a16,16,0,0,0-22.63,0L123.57,41.11l-58,21.77A16.06,16.06,0,0,0,55.35,75.23L32.11,214.68A8,8,0,0,0,40,224a8.4,8.4,0,0,0,1.32-.11l139.44-23.24a16,16,0,0,0,12.35-10.17l21.77-58L243.31,104A15.87,15.87,0,0,0,248,92.68Zm-69.87,92.19L63.32,204l47.37-47.37a28,28,0,1,0-11.32-11.32L52,192.7,71.13,77.86,126,57.29,198.7,130ZM112,132a12,12,0,1,1,12,12A12,12,0,0,1,112,132Zm96-15.32L139.31,48l24-24L232,92.68Z" fill="var(--accent-2)"/></svg>{% endif %}
        </div>
        <span class="num">02</span>
        <h3>{{ sitePl.howIWorkStep2Title }}</h3>
        <p>{{ sitePl.howIWorkStep2Desc }}</p>
      </div>
      <div class="how-card reveal">
        <div class="service-icon how-icon">
          {% if sitePl.howIWorkStep3Icon %}<img src="{{ sitePl.howIWorkStep3Icon }}" alt="" width="40" height="40" loading="lazy">{% else %}<svg viewBox="0 0 256 256"><path d="M184,120v61.65a8,8,0,0,1-2.34,5.65l-34.35,34.35a8,8,0,0,1-13.57-4.53L128,176ZM136,72H74.35a8,8,0,0,0-5.65,2.34L34.35,108.69a8,8,0,0,0,4.53,13.57L80,128ZM40,216c37.65,0,50.69-19.69,54.56-28.18L68.18,161.44C59.69,165.31,40,178.35,40,216Z" fill="var(--accent)"/><path d="M223.85,47.12a16,16,0,0,0-15-15c-12.58-.75-44.73.4-71.41,27.07L132.69,64H74.36A15.91,15.91,0,0,0,63,68.68L28.7,103a16,16,0,0,0,9.07,27.16l38.47,5.37,44.21,44.21,5.37,38.49a15.94,15.94,0,0,0,10.78,12.92,16.11,16.11,0,0,0,5.1.83A15.91,15.91,0,0,0,153,227.3L187.32,193A15.91,15.91,0,0,0,192,181.64V123.31l4.77-4.77C223.45,91.86,224.6,59.71,223.85,47.12ZM74.36,80h42.33L77.16,119.52,40,114.34Zm74.41-9.45a76.65,76.65,0,0,1,59.11-22.47,76.46,76.46,0,0,1-22.42,59.16L128,164.68,91.32,128ZM176,181.64,141.67,216l-5.19-37.17L176,139.31Zm-74.16,9.5C97.34,201,82.29,224,40,224a8,8,0,0,1-8-8c0-42.29,23-57.34,32.86-61.85a8,8,0,0,1,6.64,14.56c-6.43,2.93-20.62,12.36-23.12,38.91,26.55-2.5,36-16.69,38.91-23.12a8,8,0,1,1,14.56,6.64Z" fill="var(--accent-2)"/></svg>{% endif %}
        </div>
        <span class="num">03</span>
        <h3>{{ sitePl.howIWorkStep3Title }}</h3>
        <p>{{ sitePl.howIWorkStep3Desc }}</p>
      </div>
    </div>
  </div>
</section>
{%- endif %}

{%- if sitePl.showSkills != false %}
<section class="skills-tools" id="s4">
  <div class="wrap">
    <div class="kicker">{{ sitePl.skillsKicker or "NARZĘDZIA" }}</div>
    <h2 class="big split-title">{{ sitePl.skillsHeading }}</h2>
    <p class="lede reveal">{{ sitePl.skillsIntro }}</p>
    <div class="skills-grid">
      {% for s in skillsPl %}
      <div class="skill-chip">
        {% if s.icon %}
        <span class="skill-icon"><img src="{{ s.icon }}" alt="" loading="lazy"></span>
        {% endif %}
        <span class="skill-name">{{ s.name }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if sitePl.showExperience != false %}
<section class="experience" id="s5">
  <div class="wrap">
    <div class="kicker">{{ sitePl.experienceKicker or "OŚ CZASU" }}</div>
    <h2 class="big split-title">{{ sitePl.experienceHeading }}</h2>
    <p class="lede reveal">{{ sitePl.experienceIntro }}</p>
    <div class="exp-list">
      {% for e in experiencePl %}
      <div class="exp-row reveal">
        <div class="exp-period">{{ e.period }}</div>
        <div class="exp-main">
          <h3>{{ e.role }}</h3>
          <span class="exp-company">{{ e.company }}</span>
          {% if e.description %}<p>{{ e.description }}</p>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if sitePl.showAboutCta != false %}
<section class="final-cta" id="s6">
  <div class="wrap">
    <h2 class="big split-title">{{ sitePl.aboutCtaHeading }}</h2>
    <p class="lede reveal" style="margin:0 auto 28px;">{{ sitePl.aboutCtaParagraph }}</p>
    <a href="{{ ctaHref }}" class="btn solid reveal" style="color:#fff;background:var(--ink);"{% if ctaHref | first != "/" %} target="_blank" rel="noopener noreferrer"{% endif %}><span class="btn-label">{{ sitePl.aboutCtaButtonLabel or "Napisz do mnie" }}</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
  </div>
</section>
{%- endif %}
