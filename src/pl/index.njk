---
layout: base.pl.njk
eleventyComputed:
  title: "{{ sitePl.name }} — {{ sitePl.role }}"
  description: "{{ sitePl.metaDescription }}"
---
{% import "icons.njk" as icons %}
<!-- HERO -->
<section class="hero" id="s1">
  {% if sitePl.heroBackgroundAttachment and sitePl.heroBackgroundAttachment.mimeType == 'video/mp4' %}
  <div class="hero-bg-media"><video class="hero-bg-video" autoplay muted loop playsinline preload="metadata" src="{{ sitePl.heroBackgroundAttachment.src }}"></video></div>
  <div class="hero-bg-scrim"></div>
  {% elif sitePl.heroBackgroundAttachment and sitePl.heroBackgroundAttachment.mimeType == 'application/json' %}
  <div class="hero-bg-media"><div class="hero-bg-lottie" data-lottie-inline>{% if sitePl.heroBackgroundAttachment.jsonDataSafe %}<script type="application/json">{{ sitePl.heroBackgroundAttachment.jsonDataSafe | safe }}</script>{% endif %}</div></div>
  <div class="hero-bg-scrim"></div>
  {% elif sitePl.heroBackgroundImage %}
  <div class="hero-bg-media"><img src="{{ sitePl.heroBackgroundImage }}" alt="" loading="eager"></div>
  <div class="hero-bg-scrim"></div>
  {% elif sitePl.heroSplineUrl %}
  <iframe class="hero-spline" src="{{ sitePl.heroSplineUrl }}" title="" tabindex="-1" aria-hidden="true" loading="lazy" allow="fullscreen"></iframe>
  <div class="hero-spline-scrim"></div>
  {% endif %}
  <div class="hero-grid"></div>
  <div class="blob-wrap w1"><div class="hero-blob b1"></div></div>
  <div class="blob-wrap w2"><div class="hero-blob b2"></div></div>
  <div class="brackets"><span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span></div>
  <div class="eyebrow"><span class="plus">+</span> {{ sitePl.heroEyebrow }}</div>
  <h1 class="split-title" id="heroTitle">{{ sitePl.heroTitle }}</h1>
  <div class="sub script split-title" id="heroSub">{{ sitePl.heroSubtitle }}</div>
  <div class="hero-handwrite" id="heroHandwrite">{{ sitePl.heroHandwriteText }}</div>
  <div class="cta-row">
    <a href="/pl/portfolio/" class="btn solid"><span class="btn-label">Studia przypadków</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
    <a href="/pl/products/" class="btn ghost"><span class="btn-label">Produkty</span><span class="btn-icon btn-icon-pop"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg></span></a>
  </div>
</section>

<!-- ENTITY OVERVIEW -->
{%- if sitePl.showOverview != false %}
<section class="entity" id="s2">
  <div class="wrap">
    <div class="kicker">O MNIE <span class="n">· AKTUALIZACJA {{ sitePl.updatedLabel }}</span></div>
    <h2 class="big split-title">Kim jest {{ sitePl.name }}?</h2>
    <p class="lede reveal">{{ sitePl.bioParagraph }}</p>
    <div class="entity-grid">
      <div class="entity-col reveal">
        <label>SPECJALIZACJE</label>
        <p>{{ sitePl.specialties }}</p>
      </div>
      <div class="entity-col reveal">
        <label>DOWODY</label>
        <p>{{ sitePl.proof }}</p>
      </div>
      <div class="entity-col reveal">
        <label>BRANŻE</label>
        <p>{{ sitePl.industries }}</p>
      </div>
      <div class="entity-col reveal">
        <label>KONTAKT</label>
        <p>{{ sitePl.email }}</p>
      </div>
    </div>
  </div>
</section>
{%- endif %}

<!-- ABOUT SPLIT -->
{%- if sitePl.showAbout != false %}
<section class="about" id="s3">
  <div class="wrap about-grid">
    <div>
      <div class="kicker">{{ sitePl.name }} · {{ sitePl.role }}</div>
      <h2 class="big split-title">{{ sitePl.aboutHeading }}</h2>
      <p class="lede reveal">{{ sitePl.aboutParagraph }}</p>
      {% if testimonialsPl.length %}
      <div class="quote-card reveal">
        <span class="stars">★★★★★</span><span class="score">{{ testimonialsPl[0].rating | default(5) }}.0 / 5</span>
        <p>&quot;{{ testimonialsPl[0].quote }}&quot;</p>
        <b>{{ testimonialsPl[0].name }}</b>
      </div>
      {% endif %}
    </div>
    <div class="cta-card reveal">
      <img class="cta-photo" src="{{ sitePl.profilePhoto | default('/assets/images/profile.jpg') }}" alt="{{ sitePl.name }}">
      <div class="cta-copy">
        <div class="pill"><span class="dot-live"></span> Dostępny do pracy</div>
        <h3>{{ sitePl.ctaCardHeading }}</h3>
        <p>{{ sitePl.ctaCardParagraph }}</p>
        <div class="cta-copy-btns">
          <a href="/pl/contact/" class="btn solid"><span class="btn-label">Napisz do mnie</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
          {% if sitePl.cvUrl %}
          <a href="{{ sitePl.cvUrl }}" class="btn ghost cv-btn" download>
            <span class="btn-label">Pobierz CV</span><span class="btn-icon btn-icon-down">{{ icons.down() | safe }}</span>
          </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif %}

<!-- SERVICES -->
{%- if sitePl.showServices != false %}
<section class="services on-dark" id="s4">
  <div class="wrap">
    <div class="services-head">
      <div>
        <div class="kicker">CZYM SIĘ ZAJMUJĘ</div>
        <h2 class="big split-title">{{ sitePl.servicesHeading }}</h2>
      </div>
      <p class="lede reveal">{{ sitePl.servicesSubheading }}</p>
    </div>
    <div class="services-grid">
      {% for service in servicesPl %}
      <div class="service-card reveal">
        <div class="service-icon">
          {% if service.iconSvg %}
          {{ service.iconSvg | safe }}
          {% elif loop.index == 1 %}
          <svg viewBox="0 0 40 40"><circle cx="16" cy="20" r="12" fill="var(--accent)" opacity=".85"/><circle cx="26" cy="20" r="12" fill="var(--accent-2)" opacity=".85"/></svg>
          {% elif loop.index == 2 %}
          <svg viewBox="0 0 40 40"><rect x="7" y="13" width="20" height="14" rx="3" fill="var(--accent)" opacity=".85"/><rect x="13" y="19" width="20" height="14" rx="3" fill="var(--accent-2)" opacity=".85"/></svg>
          {% elif loop.index == 3 %}
          <svg viewBox="0 0 40 40"><rect x="6" y="6" width="13" height="13" rx="3" fill="var(--accent)" opacity=".85"/><rect x="21" y="6" width="13" height="13" rx="3" fill="var(--accent-2)" opacity=".6"/><rect x="6" y="21" width="13" height="13" rx="3" fill="var(--accent-2)" opacity=".6"/><rect x="21" y="21" width="13" height="13" rx="3" fill="var(--accent)" opacity=".85"/></svg>
          {% elif loop.index == 4 %}
          <svg viewBox="0 0 40 40"><rect x="5" y="9" width="30" height="22" rx="4" fill="var(--accent)" opacity=".55"/><rect x="5" y="9" width="30" height="8" rx="4" fill="var(--accent-2)" opacity=".9"/><circle cx="10" cy="13" r="1.4" fill="#fff"/><circle cx="14" cy="13" r="1.4" fill="#fff"/></svg>
          {% elif loop.index == 5 %}
          <svg viewBox="0 0 40 40"><path d="M20 6 L23 17 L34 20 L23 23 L20 34 L17 23 L6 20 L17 17 Z" fill="var(--accent)" opacity=".85"/><circle cx="29" cy="10" r="3" fill="var(--accent-2)"/></svg>
          {% else %}
          <svg viewBox="0 0 40 40"><path d="M12 8 L28 20 L21 22 L26 32 L22 34 L17 24 L12 29 Z" fill="var(--accent)" opacity=".85"/><circle cx="30" cy="10" r="2" fill="var(--accent-2)" opacity=".7"/><circle cx="33" cy="16" r="1.5" fill="var(--accent-2)" opacity=".6"/></svg>
          {% endif %}
        </div>
        <div>
          <h4>{{ service.title }}</h4>
          <p>{{ service.description }}</p>
        </div>
        <span class="num">{{ loop.index | pad2 }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<!-- STATS -->
{%- if sitePl.showStats != false %}
<section class="stats" id="s5">
  <div class="wrap stats-grid">
    <div>
      <h2 class="big split-title">{{ sitePl.statsHeading }}</h2>
      <p class="lede reveal">{{ sitePl.statsParagraph }}</p>
      <a href="{{ sitePl.linkedinUrl }}" class="btn ghost reveal" style="margin-top:20px;color:var(--ink);border-color:var(--line);"><span class="btn-label">Zobacz mój LinkedIn</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
    </div>
    <div class="reveal">
      <p class="num-big">{{ sitePl.statNumber }}</p>
      <p class="lede">{{ sitePl.statCaption }}</p>
    </div>
  </div>
</section>
{%- endif %}

<!-- PORTFOLIO -->
{%- if sitePl.showPortfolio != false %}
<section class="portfolio" id="portfolio">
  <div class="wrap">
    <div class="kicker">PORTFOLIO</div>
    <h2 class="big split-title">Zobacz efekty na własne oczy</h2>
    <p class="lede reveal">Przeglądaj wyselekcjonowany zbiór projektów, które zaprojektowałem — identyfikacje marek i produkty cyfrowe. <a href="/pl/portfolio/" class="text-link">Zobacz wszystkie studia przypadków <span class="btn-icon">{{ icons.up_right() | safe }}</span></a></p>
  </div>
  <div class="case-marquee" id="caseMarquee">
    <div class="case-track">
      {% for cs in caseStudiesPl %}
      <a class="case-card" href="/pl/portfolio/{{ cs.slug }}/">
        {% if cs.coverImage %}<img class="case-thumb" src="{{ cs.coverImage }}" alt="{{ cs.title }}" loading="lazy">{% else %}<div class="case-thumb"></div>{% endif %}
        <div class="case-body">
          <span class="case-tag">{{ cs.tag }}</span>
          <h4>{{ cs.title }}</h4>
          <span class="date">{{ cs.date }}</span>
        </div>
      </a>
      {% endfor %}
      {% for cs in caseStudiesPl %}
      <a class="case-card" href="/pl/portfolio/{{ cs.slug }}/" aria-hidden="true" tabindex="-1">
        {% if cs.coverImage %}<img class="case-thumb" src="{{ cs.coverImage }}" alt="{{ cs.title }}" loading="lazy">{% else %}<div class="case-thumb"></div>{% endif %}
        <div class="case-body">
          <span class="case-tag">{{ cs.tag }}</span>
          <h4>{{ cs.title }}</h4>
          <span class="date">{{ cs.date }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<!-- PRODUCTS -->
{%- if sitePl.showProducts != false %}
<section class="products" id="products">
  <div class="wrap">
    <div class="kicker">PRODUKTY</div>
    <h2 class="big split-title">Produkty, które wdrożyłem</h2>
    <p class="lede reveal">Produkty, które projektuję i buduję od A do Z — marka, UX, front end, back end i wdrożenie. Każdy z nich jest realnym rozwiązaniem realnego problemu. <a href="/pl/products/" class="text-link">Zobacz wszystkie produkty <span class="btn-icon">{{ icons.up_right() | safe }}</span></a></p>
    <div class="prod-grid home">
      {% for p in productsPl %}
      <a class="prod-card reveal" href="/pl/products/{{ p.slug }}/">
        {% if p.coverImage %}<img class="prod-thumb" src="{{ p.coverImage }}" alt="{{ p.name }}" loading="lazy">{% else %}<div class="prod-thumb"></div>{% endif %}
        <div class="prod-head">
          <h4>{{ p.name }}</h4>
          <span class="status {{ 'soon' if p.status == 'coming-soon' else '' }}">{{ 'WKRÓTCE' if p.status == 'coming-soon' else 'DOSTĘPNY' }}</span>
        </div>
        <p>{{ p.description }}</p>
        <div class="prod-foot">
          <span class="cat">{{ p.category }}</span>
          <span class="view-link">Zobacz produkt <span class="btn-icon">{{ icons.up_right() | safe }}</span></span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<!-- PHOTOGRAPHY -->
{%- if sitePl.showPhotography != false %}
<section class="photography" id="photography">
  <div class="wrap">
    <div class="kicker">{{ sitePl.photographyKicker }}</div>
    <h2 class="big split-title">{{ sitePl.photographyHeading }}</h2>
    <p class="lede reveal">{{ sitePl.photographyIntro }} {% if sitePl.photographyCtaLabel and sitePl.photographyCtaUrl %}<a href="{{ sitePl.photographyCtaUrl }}" class="text-link" target="_blank" rel="noopener noreferrer">{{ sitePl.photographyCtaLabel }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}</p>
  </div>
  {% if site.photographyImages and site.photographyImages.length %}
  <div class="photo-marquee" id="photoMarquee">
    <div class="photo-track">
      {% for img in site.photographyImages %}
      <button type="button" class="photo-tile reveal" data-lightbox-src="{{ img.src }}" data-lightbox-alt="{{ sitePl.photographyHeading }}"><img src="{{ img.src }}" alt="{{ sitePl.photographyHeading }}" loading="lazy"></button>
      {% endfor %}
      {% for img in site.photographyImages %}
      <button type="button" class="photo-tile reveal" aria-hidden="true" tabindex="-1" data-lightbox-src="{{ img.src }}" data-lightbox-alt="{{ sitePl.photographyHeading }}"><img src="{{ img.src }}" alt="{{ sitePl.photographyHeading }}" loading="lazy"></button>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="wrap">
    <div class="photo-grid">
      <div class="photo-tile reveal"></div>
      <div class="photo-tile reveal"></div>
      <div class="photo-tile reveal"></div>
      <div class="photo-tile reveal"></div>
    </div>
  </div>
  {% endif %}
</section>
{%- endif %}

<!-- TESTIMONIALS -->
{%- if sitePl.showTestimonials != false %}
<section class="testi" id="s7">
  <div class="wrap testi-grid">
    <div>
      <div class="kicker">OPINIE</div>
      <h2 class="big split-title">Co mówią klienci</h2>
      <p class="lede reveal">Zobacz, co mówią osoby, z którymi współpracowałem. Prawdziwe projekty, prawdziwe doświadczenia, prawdziwe opinie.</p>
    </div>
    <div class="testi-wrap reveal">
      <div class="testi-card" id="testiCard">
        {% for t in testimonialsPl %}
        <div class="testi-slide {{ 'active' if loop.first else '' }}">
          <span class="stars">★★★★★</span>
          <p>&quot;{{ t.quote }}&quot;</p>
          <b>{{ t.name }}</b>
        </div>
        {% endfor %}
      </div>
      <div class="testi-nav">
        <button id="testiPrev"><span>{{ icons.chevron_left() | safe }}</span></button>
        <button id="testiNext"><span>{{ icons.chevron_right() | safe }}</span></button>
        <div class="testi-dots" id="testiDots"></div>
      </div>
    </div>
  </div>
</section>
{%- endif %}

<!-- BIG QUOTE CTA -->
{%- if sitePl.showBigQuote != false %}
<section class="bigquote on-dark">
  {%- if sitePl.bigQuoteBackgroundAttachment and sitePl.bigQuoteBackgroundAttachment.mimeType == 'video/mp4' %}
  <div class="bigquote-bg-media"><video class="bigquote-bg-video" autoplay muted loop playsinline preload="metadata" src="{{ sitePl.bigQuoteBackgroundAttachment.src }}"></video></div>
  <div class="bigquote-bg-scrim"></div>
  {%- elif sitePl.bigQuoteBackgroundAttachment and sitePl.bigQuoteBackgroundAttachment.mimeType == 'application/json' %}
  <div class="bigquote-bg-media"><div class="bigquote-bg-lottie" data-lottie-inline>{% if sitePl.bigQuoteBackgroundAttachment.jsonDataSafe %}<script type="application/json">{{ sitePl.bigQuoteBackgroundAttachment.jsonDataSafe | safe }}</script>{% endif %}</div></div>
  <div class="bigquote-bg-scrim"></div>
  {%- elif sitePl.bigQuoteBackgroundImage %}
  <div class="bigquote-bg-media"><img src="{{ sitePl.bigQuoteBackgroundImage }}" alt="" loading="lazy"></div>
  <div class="bigquote-bg-scrim"></div>
  {%- endif %}
  <div class="wrap">
    <h2 class="fill-title">{{ sitePl.bigQuoteLead }} {{ sitePl.bigQuoteFade }}</h2>
    <p class="foot reveal">{{ sitePl.bigQuoteParagraph }}</p>
    <a href="/pl/portfolio/" class="btn solid reveal"><span class="btn-label">Zobacz moje prace</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
  </div>
</section>
{%- endif %}

<!-- FINAL CTA -->
{%- if sitePl.showFinalCta != false %}
<section class="final-cta" id="contact">
  <div class="wrap">
    <h2 class="big split-title">{{ sitePl.finalCtaHeading }}</h2>
    <p class="lede reveal" style="margin:0 auto 28px;">{{ sitePl.finalCtaSubheading }}</p>
    <a href="/pl/contact/" class="btn solid reveal" style="color:#fff;background:var(--ink);"><span class="btn-label">Napisz do mnie</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
  </div>
</section>
{%- endif %}
