---
layout: base.pl.njk
eleventyComputed:
  title: "Portfolio — {{ sitePl.name }}"
  description: "Przegląd studiów przypadków z zakresu marki i projektowania produktu."
---
<section class="portfolio-hero" id="s1">
  <div class="wrap">
    <div class="kicker">PORTFOLIO</div>
    <h1 class="big split-title">Przegląd zrealizowanych projektów</h1>
    <p class="lede reveal">Identyfikacje marek i produkty cyfrowe, przedstawione przez problem, podejście i efekt.</p>
  </div>
</section>

<section class="portfolio-list">
  <div class="wrap">
    <div class="filter-pills" id="portfolioFilters">
      <button class="pill active" data-filter="all">Wszystkie</button>
      {% for cat in portfolioCategoriesPl %}
      <button class="pill" data-filter="{{ cat }}">{{ cat }}</button>
      {% endfor %}
    </div>

    <div class="case-grid wide" id="portfolioGrid">
      {% for cs in caseStudiesPl %}
      <a class="case-card reveal filter-card" href="/pl/portfolio/{{ cs.slug }}/" data-category="{{ cs.category | default(cs.tag) }}">
        {% if cs.coverImage %}<img class="case-thumb" src="{{ cs.coverImage }}" alt="{{ cs.title }}" loading="lazy">{% else %}<div class="case-thumb"></div>{% endif %}
        <div class="case-body">
          <span class="case-tag">{{ cs.tag }}</span>
          <h4>{{ cs.title }}</h4>
          <span class="date">{{ cs.date }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
