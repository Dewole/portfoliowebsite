---
layout: base.njk
eleventyComputed:
  title: "Contact — {{ site.name }}"
  description: "{{ site.contactIntro }}"
---
<section class="contact-hero" id="s1">
  <div class="wrap contact-grid">
    <div>
      <div class="pill"><span class="dot-live"></span> {{ site.availabilityStatus }}</div>
      <h1 class="big split-title">{{ site.contactHeading }}</h1>
      <p class="lede reveal">{{ site.contactIntro }}</p>
      <p class="contact-email reveal">Or email me directly at <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <img class="photo-block tall reveal" src="{{ site.profilePhoto | default('/assets/images/profile.jpg') }}" alt="{{ site.name }}">
    </div>
    <form class="contact-form reveal" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact">
      <p class="hp"><label>Don't fill this out: <input name="bot-field"></label></p>
      <label>Name
        <input type="text" name="name" required>
      </label>
      <label>Email
        <input type="email" name="email" required>
      </label>
      <label>Message
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button type="submit" class="btn solid cta-wide"><span class="btn-label">Send message</span><span class="btn-icon arrow">↗</span></button>
    </form>
  </div>
</section>
