{% import "icons.njk" as icons %}
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set ml = sitePl %}{% include "seo-head.njk" %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#0a0b10">
{#- fonts the first screen needs; the hero script font only on the homepage -#}
<link rel="preload" href="/assets/fonts/OriginDisplay-800.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/OriginDisplay-700.woff2" as="font" type="font/woff2" crossorigin>
{% if page.url == "/" or page.url == "/pl/" %}<link rel="preload" href="/assets/fonts/Holimount.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<noscript><style>.reveal{opacity:1!important;transform:none!important}.split-title .word-inner{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body>
<a class="skip-link" href="#main">Przejdź do treści</a>
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

<div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
<div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>

<div class="rail" id="rail" role="navigation" aria-label="Sekcje strony"></div>

<header class="nav">
  <div class="brand"><a href="/pl/">
    {% if sitePl.showLogo != false and sitePl.logo %}
      {% if sitePl.logoIsAnimated %}
      <span class="brand-logo brand-logo-lottie" data-lottie-inline{% if sitePl.logoWidth and sitePl.logoHeight %} style="aspect-ratio:{{ sitePl.logoWidth }}/{{ sitePl.logoHeight }}"{% endif %}>{% if sitePl.logoAnimationDataSafe %}<script type="application/json">{{ sitePl.logoAnimationDataSafe | safe }}</script>{% endif %}</span>
      {% else %}
      <img class="brand-logo" src="{{ sitePl.logo }}" alt="{{ sitePl.name }}">
      {% endif %}
    {% endif %}
    {% if sitePl.showBrandText != false %}
    <span class="brand-text"><b>{{ sitePl.name }}</b><span>{{ sitePl.role }}</span></span>
    {% endif %}
  </a></div>
  <div class="mid">
    <span>{% if sitePl.phone %}<a href="{{ sitePl.phone | telHref }}">{{ sitePl.phone }}</a>{% endif %}</span>
    <span>{% if sitePl.email %}<a href="mailto:{{ sitePl.email }}">{{ sitePl.email }}</a>{% endif %}</span>
    {% if sitePl.linkedinUrl %}<a href="{{ sitePl.linkedinUrl }}">{{ sitePl.linkedinLabel or "LinkedIn" }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}
  </div>
  <div class="right">
    <select id="langSwitch" aria-label="Język"><option value="en">English</option><option value="pl">Polski</option></select>
    <button class="menu-btn" id="menuBtn" aria-label="Otwórz menu" aria-expanded="false" aria-controls="sideMenu" aria-haspopup="dialog"><span>Menu</span><span class="burger"><i></i><i></i></span></button>
  </div>
</header>

<div class="side-menu-overlay" id="menuOverlay"></div>
<aside class="side-menu" id="sideMenu" role="dialog" aria-modal="true" aria-label="Menu nawigacji" inert>
  <div class="side-menu-top">
    <div class="side-menu-brand">
      {% if sitePl.showLogo != false and sitePl.logo %}
        {% if sitePl.logoIsAnimated %}
        <span class="side-menu-logo brand-logo-lottie" data-lottie-inline{% if sitePl.logoWidth and sitePl.logoHeight %} style="aspect-ratio:{{ sitePl.logoWidth }}/{{ sitePl.logoHeight }}"{% endif %}>{% if sitePl.logoAnimationDataSafe %}<script type="application/json">{{ sitePl.logoAnimationDataSafe | safe }}</script>{% endif %}</span>
        {% else %}
        <img class="side-menu-logo" src="{{ sitePl.logo }}" alt="{{ sitePl.name }}">
        {% endif %}
      {% endif %}
      {% if sitePl.showBrandText != false %}
      <b>{{ sitePl.name }}</b>
      {% endif %}
    </div>
    <button class="side-menu-close" id="menuClose" aria-label="Zamknij menu">✕</button>
  </div>
  <nav class="side-menu-links">
    <a href="/pl/"><span>Strona główna</span><span class="idx">01</span></a>
    <a href="/pl/portfolio/"><span>Portfolio</span><span class="idx">02</span></a>
    <a href="/pl/products/"><span>Produkty</span><span class="idx">03</span></a>
    <a href="/pl/about/"><span>O mnie</span><span class="idx">04</span></a>
    <a href="/pl/contact/"><span>Kontakt</span><span class="idx">05</span></a>
  </nav>
  <div class="side-menu-foot">
    {% if sitePl.linkedinUrl %}<a href="{{ sitePl.linkedinUrl }}">{{ sitePl.linkedinLabel or "LinkedIn" }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}
    {% if sitePl.figmaUrl %}<a href="{{ sitePl.figmaUrl }}">{{ sitePl.figmaLabel or "Figma" }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}
    <p>{% if sitePl.email %}<a href="mailto:{{ sitePl.email }}">{{ sitePl.email }}</a>{% endif %}</p>
  </div>
</aside>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-col">
        <label>SKONTAKTUJ SIĘ</label>
        <p>{% if sitePl.phone %}<a href="{{ sitePl.phone | telHref }}">{{ sitePl.phone }}</a>{% endif %}</p>
        <p>{% if sitePl.email %}<a href="mailto:{{ sitePl.email }}">{{ sitePl.email }}</a>{% endif %}</p>
      </div>
      <div class="foot-col">
        <label>NAWIGACJA</label>
        <a href="/pl/">Strona główna</a><a href="/pl/portfolio/">Portfolio</a><a href="/pl/products/">Produkty</a><a href="/pl/about/">O mnie</a><a href="/pl/contact/">Kontakt</a>
      </div>
      <div class="foot-col">
        <label>LINKI</label>
        {% if sitePl.figmaUrl %}<a href="{{ sitePl.figmaUrl }}">{{ sitePl.figmaLabel or "Figma" }}</a>{% endif %}{% if sitePl.linkedinUrl %}<a href="{{ sitePl.linkedinUrl }}">{{ sitePl.linkedinLabel or "LinkedIn" }}</a>{% endif %}
        {% for link in sitePl.footerLinks %}<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label_pl }}</a>{% endfor %}
      </div>
    </div>
  </div>
  <div class="foot-word">{{ sitePl.name }}</div>
  <div class="wrap">
    <div class="foot-bottom">
      <span>© {{ sitePl.copyrightYear }} Wszelkie prawa zastrzeżone</span>
      <span>{{ sitePl.footerNote }}</span>
    </div>
  </div>
</footer>

<!-- Always loaded: used for an animated logo AND for any Lottie/animated
     JSON attachment on a case-study/product detail page's gallery. Small
     and cached from cdnjs, only activates on elements carrying
     data-lottie-src. -->
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js"></script>
<script defer src="/assets/main.js"></script>
</body>
</html>
