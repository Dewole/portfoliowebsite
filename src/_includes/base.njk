{% import "icons.njk" as icons %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set ml = site %}{% include "seo-head.njk" %}
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<meta name="theme-color" content="#0a0b10">
{#- fonts the first screen needs; the hero script font only on the homepage -#}
<link rel="preload" href="/assets/fonts/OriginDisplay-800.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/OriginDisplay-700.woff2" as="font" type="font/woff2" crossorigin>
{% if page.url == "/" or page.url == "/pl/" %}<link rel="preload" href="/assets/fonts/Holimount.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<noscript><style>.reveal{opacity:1!important;transform:none!important}.split-title .word-inner{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

<div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
<div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>

<div class="rail" id="rail" role="navigation" aria-label="Page sections"></div>

<header class="nav">
  <div class="brand"><a href="/">
    {% if site.showLogo != false and site.logo %}
      {% if site.logoIsAnimated %}
      <span class="brand-logo brand-logo-lottie" data-lottie-inline{% if site.logoWidth and site.logoHeight %} style="aspect-ratio:{{ site.logoWidth }}/{{ site.logoHeight }}"{% endif %}>{% if site.logoAnimationDataSafe %}<script type="application/json">{{ site.logoAnimationDataSafe | safe }}</script>{% endif %}</span>
      {% else %}
      <img class="brand-logo" src="{{ site.logo }}" alt="{{ site.name }}">
      {% endif %}
    {% endif %}
    {% if site.showBrandText != false %}
    <span class="brand-text"><b>{{ site.name }}</b><span>{{ site.role }}</span></span>
    {% endif %}
  </a></div>
  <div class="mid">
    <span>{% if site.phone %}<a href="{{ site.phone | telHref }}">{{ site.phone }}</a>{% endif %}</span>
    <span>{% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</span>
    {% if site.linkedinUrl %}<a href="{{ site.linkedinUrl }}">{{ site.linkedinLabel or "LinkedIn" }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}
  </div>
  <div class="right">
    <select id="langSwitch" aria-label="Language"><option value="en">English</option><option value="pl">Polski</option></select>
    <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="sideMenu" aria-haspopup="dialog"><span>Menu</span><span class="burger"><i></i><i></i></span></button>
  </div>
</header>

<div class="side-menu-overlay" id="menuOverlay"></div>
<aside class="side-menu" id="sideMenu" role="dialog" aria-modal="true" aria-label="Site menu" inert>
  <div class="side-menu-top">
    <div class="side-menu-brand">
      {% if site.showLogo != false and site.logo %}
        {% if site.logoIsAnimated %}
        <span class="side-menu-logo brand-logo-lottie" data-lottie-inline{% if site.logoWidth and site.logoHeight %} style="aspect-ratio:{{ site.logoWidth }}/{{ site.logoHeight }}"{% endif %}>{% if site.logoAnimationDataSafe %}<script type="application/json">{{ site.logoAnimationDataSafe | safe }}</script>{% endif %}</span>
        {% else %}
        <img class="side-menu-logo" src="{{ site.logo }}" alt="{{ site.name }}">
        {% endif %}
      {% endif %}
      {% if site.showBrandText != false %}
      <b>{{ site.name }}</b>
      {% endif %}
    </div>
    <button class="side-menu-close" id="menuClose" aria-label="Close menu">✕</button>
  </div>
  <nav class="side-menu-links">
    <a href="/"><span>Home</span><span class="idx">01</span></a>
    <a href="/portfolio/"><span>Portfolio</span><span class="idx">02</span></a>
    <a href="/products/"><span>Products</span><span class="idx">03</span></a>
    <a href="/about/"><span>About</span><span class="idx">04</span></a>
    <a href="/contact/"><span>Contact</span><span class="idx">05</span></a>
  </nav>
  <div class="side-menu-foot">
    {% if site.linkedinUrl %}<a href="{{ site.linkedinUrl }}">{{ site.linkedinLabel or "LinkedIn" }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}
    {% if site.figmaUrl %}<a href="{{ site.figmaUrl }}">{{ site.figmaLabel or "Figma" }} <span class="btn-icon">{{ icons.up_right() | safe }}</span></a>{% endif %}
    <p>{% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</p>
  </div>
</aside>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-col">
        <label>LET'S TALK</label>
        <p>{% if site.phone %}<a href="{{ site.phone | telHref }}">{{ site.phone }}</a>{% endif %}</p>
        <p>{% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</p>
      </div>
      <div class="foot-col">
        <label>NAVIGATE</label>
        <a href="/">Home</a><a href="/portfolio/">Portfolio</a><a href="/products/">Products</a><a href="/about/">About me</a><a href="/contact/">Contact</a>
      </div>
      <div class="foot-col">
        <label>LINKS</label>
        {% if site.figmaUrl %}<a href="{{ site.figmaUrl }}">{{ site.figmaLabel or "Figma" }}</a>{% endif %}{% if site.linkedinUrl %}<a href="{{ site.linkedinUrl }}">{{ site.linkedinLabel or "LinkedIn" }}</a>{% endif %}
        {% for link in site.footerLinks %}<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>{% endfor %}
      </div>
    </div>
  </div>
  <div class="foot-word">{{ site.name }}</div>
  <div class="wrap">
    <div class="foot-bottom">
      <span>© {{ site.copyrightYear }} All rights reserved</span>
      <span>{{ site.footerNote }}</span>
    </div>
  </div>
</footer>

<!-- Always loaded: used for an animated logo AND for any Lottie/animated
     JSON attachment on a case-study/product detail page's gallery. Small
     and cached from cdnjs, only activates on elements carrying
     data-lottie-src. -->
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js"></script>
<script defer src="/assets/main.js"></script>
</body>
</html>
