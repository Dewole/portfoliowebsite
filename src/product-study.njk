---
layout: base.njk
pagination:
  data: products
  size: 1
  alias: p
permalink: "/products/{{ p.slug }}/"
eleventyComputed:
  title: "{{ p.name }} — {{ site.name }}"
  description: "{{ p.description }}"
  image: "{{ p.coverImage or p.heroImage }}"
---
{% import "icons.njk" as icons %}
<section class="cs-detail" id="s1">
  <div class="wrap">
    <a href="/products/" class="cs-back"><span class="btn-icon btn-icon-ul cs-back-icon">{{ icons.up_left() | safe }}</span> Go back to products</a>
    <div class="cs-meta">
      <span class="status {{ 'soon' if p.status == 'coming-soon' else '' }}">{{ 'COMING SOON' if p.status == 'coming-soon' else 'LIVE' }}</span>
      <span class="case-tag">{{ p.category }}</span>
    </div>
    <h1 class="big split-title cs-title">{{ p.name }}</h1>
    {% if p.heroAttachment and p.heroAttachment.mimeType == 'video/mp4' %}
    <div class="cs-hero-img"><video class="cs-hero-video" autoplay muted loop playsinline preload="metadata" src="{{ p.heroAttachment.src }}"></video></div>
    {% elif p.heroAttachment and p.heroAttachment.mimeType == 'application/json' %}
    <div class="cs-hero-img"><div class="cs-hero-lottie" data-lottie-inline>{% if p.heroAttachment.jsonDataSafe %}<script type="application/json">{{ p.heroAttachment.jsonDataSafe | safe }}</script>{% endif %}</div></div>
    {% elif p.heroImage %}
    <div class="cs-hero-img"><img src="{{ p.heroImage }}" alt="{{ p.name }}" loading="lazy"></div>
    {% elif p.coverImage %}
    <div class="cs-hero-img"><img src="{{ p.coverImage }}" alt="{{ p.name }}" loading="lazy"></div>
    {% else %}
    <div class="cs-hero-thumb"></div>
    {% endif %}
    <div class="cs-author">
      <div class="avatar"></div>
      <div>
        <b>{{ site.name }}</b>
        <span>{{ site.role }}</span>
      </div>
    </div>
  </div>
</section>

<section class="cs-body">
  <div class="wrap">
    <div class="kicker">ABOUT THE PRODUCT</div>
    <h2 class="big split-title">Product overview</h2>
    <div class="cs-prose">
      {% if p.description %}<p>{{ p.description }}</p>{% endif %}
      {% if p.problem %}<p>{{ p.problem }}</p>{% endif %}
      {% if p.approach %}<p>{{ p.approach }}</p>{% endif %}
      {% if p.outcome %}<p>{{ p.outcome }}</p>{% endif %}
    </div>

    {% if p.sections and p.sections.length %}
    <div class="cs-sections">
      {% for section in p.sections %}
      <div class="cs-section cs-section-{{ section.layout or 'full' }}">
        {% if section.title or section.description %}
        <div class="cs-section-text">
          {% if section.title %}<h3 class="cs-section-title">{{ section.title }}</h3>{% endif %}
          {% if section.description %}<p>{{ section.description }}</p>{% endif %}
        </div>
        {% endif %}
        {% if section.media and section.media.length %}
        <div class="cs-section-media cs-media-grid">
          {% for m in section.media %}
          <div class="cs-grid-item">
            {% if m.mimeType == 'video/mp4' %}
            <div class="cs-media-video-wrap" data-lightbox-src="{{ m.src }}" data-lightbox-type="video" data-lightbox-alt="{{ p.title }}">
              <video class="cs-media-video" muted loop playsinline preload="metadata" src="{{ m.src }}"></video>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% elif m.mimeType == 'application/json' %}
            <div class="cs-media-lottie-wrap" data-lightbox-src="{{ m.src }}" data-lightbox-type="lottie" data-lightbox-alt="{{ p.title }}">
              <div class="cs-media-lottie" data-lottie-inline{% if m.jsonWidth and m.jsonHeight %} style="aspect-ratio:{{ m.jsonWidth }}/{{ m.jsonHeight }}"{% endif %}>{% if m.jsonDataSafe %}<script type="application/json">{{ m.jsonDataSafe | safe }}</script>{% endif %}</div>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% else %}
            <button type="button" class="cs-media-img" data-lightbox-src="{{ m.src }}" data-lightbox-alt="{{ p.title }}"><img src="{{ m.src }}" alt="{{ p.title }}" loading="lazy"></button>
            {% endif %}
            {% if m.caption %}<p class="cs-media-caption">{{ m.caption }}</p>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if (p.images and p.images.length) or (p.attachments and p.attachments.length) %}
    <div class="cs-media">
      <div class="kicker">GALLERY</div>
      {% if p.images and p.images.length %}
      <div class="cs-media-grid">
        {% for img in p.images %}
        <button type="button" class="cs-media-img" data-lightbox-src="{{ img.src }}" data-lightbox-alt="{{ p.name }}"><img src="{{ img.src }}" alt="{{ p.name }}" loading="lazy"></button>
        {% endfor %}
      </div>
      {% endif %}
      {% if p.attachments and p.attachments.length %}
      <div class="cs-media-attachments">
        {% for att in p.attachments %}
          {% if att.mimeType == 'video/mp4' %}
          <div>
            <div class="cs-media-video-wrap" data-lightbox-src="{{ att.src }}" data-lightbox-type="video" data-lightbox-alt="{{ p.name }}">
              <video class="cs-media-video" muted loop playsinline preload="metadata" src="{{ att.src }}"></video>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% if att.caption %}<p class="cs-media-caption">{{ att.caption }}</p>{% endif %}
          </div>
          {% elif att.mimeType == 'application/json' %}
          <div>
            <div class="cs-media-lottie-wrap" data-lightbox-src="{{ att.src }}" data-lightbox-type="lottie" data-lightbox-alt="{{ p.name }}">
              <div class="cs-media-lottie" data-lottie-inline{% if att.jsonWidth and att.jsonHeight %} style="aspect-ratio:{{ att.jsonWidth }}/{{ att.jsonHeight }}"{% endif %}>{% if att.jsonDataSafe %}<script type="application/json">{{ att.jsonDataSafe | safe }}</script>{% endif %}</div>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% if att.caption %}<p class="cs-media-caption">{{ att.caption }}</p>{% endif %}
          </div>
          {% else %}
          <a class="cs-media-file" href="{{ att.src }}" target="_blank" rel="noopener noreferrer" download>
            <span class="cs-media-file-icon">⬇</span>
            <span>{{ att.caption or att.filename or 'Download file' }}</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
    <div class="cs-nav-row">
      <a href="/products/" class="btn ghost" style="color:var(--ink);border-color:var(--line);"><span class="btn-icon btn-icon-ul">{{ icons.up_left() | safe }}</span><span class="btn-label">All products</span></a>
      {% if p.link and p.link != '#' %}
      <a href="{{ p.link }}" class="btn solid" target="_blank" rel="noopener noreferrer"><span class="btn-label">Visit live product</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
      {% else %}
      <a href="/contact/" class="btn solid"><span class="btn-label">Start a project like this</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
      {% endif %}
    </div>
  </div>
</section>
