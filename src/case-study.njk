---
layout: base.njk
pagination:
  data: caseStudies
  size: 1
  alias: cs
permalink: "/portfolio/{{ cs.slug }}/"
eleventyComputed:
  title: "{{ cs.title }} — {{ site.name }}"
  description: "{{ cs.overview }}"
  image: "{{ cs.coverImage or cs.heroImage }}"
---
{% import "icons.njk" as icons %}
<section class="cs-detail" id="s1">
  <div class="wrap">
    <a href="/portfolio/" class="cs-back"><span class="btn-icon btn-icon-ul cs-back-icon">{{ icons.up_left() | safe }}</span> Go back to portfolio</a>
    <div class="cs-meta">
      <span>{{ cs.date }}</span>
      <span class="case-tag">{{ cs.tag }}</span>
    </div>
    <h1 class="big split-title cs-title">{{ cs.title }}</h1>
    {% if cs.heroAttachment and cs.heroAttachment.mimeType == 'video/mp4' %}
    <div class="cs-hero-img"><video class="cs-hero-video" autoplay muted loop playsinline preload="metadata" src="{{ cs.heroAttachment.src }}"></video></div>
    {% elif cs.heroAttachment and cs.heroAttachment.mimeType == 'application/json' %}
    <div class="cs-hero-img"><div class="cs-hero-lottie" data-lottie-inline>{% if cs.heroAttachment.jsonDataSafe %}<script type="application/json">{{ cs.heroAttachment.jsonDataSafe | safe }}</script>{% endif %}</div></div>
    {% elif cs.heroImage %}
    <div class="cs-hero-img"><img src="{{ cs.heroImage }}" alt="{{ cs.title }}" loading="lazy"></div>
    {% elif cs.coverImage %}
    <div class="cs-hero-img"><img src="{{ cs.coverImage }}" alt="{{ cs.title }}" loading="lazy"></div>
    {% else %}
    <div class="cs-hero-thumb"></div>
    {% endif %}
    <div class="cs-author">
      <div class="avatar"></div>
      <div>
        <b>{{ site.name }}</b>
        <span>{{ cs.role | default(site.role) }}</span>
      </div>
    </div>
  </div>
</section>

<section class="cs-details">
  <div class="wrap cs-details-grid">
    <div class="cs-details-left">
      <h2 class="big split-title cs-details-title"><span class="muted">Project</span> Details</h2>
      {% if cs.overview %}<p class="cs-details-desc">{{ cs.overview }}</p>{% endif %}
      {% if cs.secondaryDescription %}<p class="cs-details-desc-secondary">{{ cs.secondaryDescription }}</p>{% endif %}
    </div>
    <div class="cs-details-right">
      {% if cs.client %}
      <div class="cs-details-row"><span class="cs-details-label">Client</span><span class="cs-details-value">{{ cs.client }}</span></div>
      {% endif %}
      {% if cs.services %}
      <div class="cs-details-row"><span class="cs-details-label">Services</span><span class="cs-details-value">{{ cs.services }}</span></div>
      {% endif %}
      {% if cs.date %}
      <div class="cs-details-row"><span class="cs-details-label">Year</span><span class="cs-details-value">{{ cs.date }}</span></div>
      {% endif %}
      {% if cs.link and cs.link != '#' %}
      <div class="cs-details-row"><span class="cs-details-label">Site</span><span class="cs-details-value"><a href="{{ cs.link | absoluteUrl }}" target="_blank" rel="noopener noreferrer">Visit website <span class="btn-icon">{{ icons.up_right() | safe }}</span></a></span></div>
      {% endif %}
    </div>
  </div>
</section>

<section class="cs-body">
  <div class="wrap">

    {% if cs.sections and cs.sections.length %}
    <div class="cs-sections">
      {% for section in cs.sections %}
      <div class="cs-section cs-section-{{ section.layout or 'full' }}">
        {% if section.title or section.description %}
        <div class="cs-section-text">
          {% if section.title %}<h3 class="cs-section-title">{{ section.title }}</h3>{% endif %}
          {% if section.description %}<p>{{ section.description }}</p>{% endif %}
        </div>
        {% endif %}
        {% if section.media and section.media.length %}
        <div class="cs-section-media cs-media-grid">
          {% for m in section.media %}
          <div class="cs-grid-item">
            {% if m.mimeType == 'video/mp4' %}
            <div class="cs-media-video-wrap" data-lightbox-src="{{ m.src }}" data-lightbox-type="video" data-lightbox-alt="{{ cs.title }}">
              <video class="cs-media-video" muted loop playsinline preload="metadata" src="{{ m.src }}"></video>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% elif m.mimeType == 'application/json' %}
            <div class="cs-media-lottie-wrap" data-lightbox-src="{{ m.src }}" data-lightbox-type="lottie" data-lightbox-alt="{{ cs.title }}">
              <div class="cs-media-lottie" data-lottie-inline{% if m.jsonWidth and m.jsonHeight %} style="aspect-ratio:{{ m.jsonWidth }}/{{ m.jsonHeight }}"{% endif %}>{% if m.jsonDataSafe %}<script type="application/json">{{ m.jsonDataSafe | safe }}</script>{% endif %}</div>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% else %}
            <button type="button" class="cs-media-img" data-lightbox-src="{{ m.src }}" data-lightbox-alt="{{ cs.title }}"><img src="{{ m.src }}" alt="{{ cs.title }}" loading="lazy"></button>
            {% endif %}
            {% if m.caption %}<p class="cs-media-caption">{{ m.caption }}</p>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if (cs.images and cs.images.length) or (cs.attachments and cs.attachments.length) %}
    <div class="cs-media">
      <div class="kicker">{{ cs.galleryKicker or "GALLERY" }}</div>
      {% if cs.images and cs.images.length %}
      <div class="cs-media-grid">
        {% for img in cs.images %}
        <button type="button" class="cs-media-img" data-lightbox-src="{{ img.src }}" data-lightbox-alt="{{ cs.title }}"><img src="{{ img.src }}" alt="{{ cs.title }}" loading="lazy"></button>
        {% endfor %}
      </div>
      {% endif %}
      {% if cs.attachments and cs.attachments.length %}
      <div class="cs-media-attachments">
        {% for att in cs.attachments %}
          {% if att.mimeType == 'video/mp4' %}
          <div>
            <div class="cs-media-video-wrap" data-lightbox-src="{{ att.src }}" data-lightbox-type="video" data-lightbox-alt="{{ cs.title }}">
              <video class="cs-media-video" muted loop playsinline preload="metadata" src="{{ att.src }}"></video>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% if att.caption %}<p class="cs-media-caption">{{ att.caption }}</p>{% endif %}
          </div>
          {% elif att.mimeType == 'application/json' %}
          <div>
            <div class="cs-media-lottie-wrap" data-lightbox-src="{{ att.src }}" data-lightbox-type="lottie" data-lightbox-alt="{{ cs.title }}">
              <div class="cs-media-lottie" data-lottie-inline{% if att.jsonWidth and att.jsonHeight %} style="aspect-ratio:{{ att.jsonWidth }}/{{ att.jsonHeight }}"{% endif %}>{% if att.jsonDataSafe %}<script type="application/json">{{ att.jsonDataSafe | safe }}</script>{% endif %}</div>
              <span class="cs-media-expand" aria-hidden="true">⤢</span>
            </div>
            {% if att.caption %}<p class="cs-media-caption">{{ att.caption }}</p>{% endif %}
          </div>
          {% else %}
          <a class="cs-media-file" href="{{ att.src }}" target="_blank" rel="noopener noreferrer" download>
            <span class="cs-media-file-icon">⬇</span>
            <span>{{ att.caption or att.filename or 'Download file' }}</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
    <div class="cs-nav-row">
      <a href="/portfolio/" class="btn ghost" style="color:var(--ink);border-color:var(--line);"><span class="btn-icon btn-icon-ul">{{ icons.up_left() | safe }}</span><span class="btn-label">All case studies</span></a>
      <a href="/contact/" class="btn solid"><span class="btn-label">Start a project like this</span><span class="btn-icon">{{ icons.up_right() | safe }}</span></a>
    </div>
  </div>
</section>
