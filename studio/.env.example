# Copy this file to .env, fill in your own values.
# Get these from https://www.sanity.io/manage after creating your project.
SANITY_STUDIO_PROJECT_ID=l4gtk7o7
SANITY_STUDIO_DATASET=production

# Only needed to run `npm run migrate` (never commit the real token).
# Create one at https://www.sanity.io/manage -> API -> Tokens -> Add API token
# with "Editor" permissions.
SANITY_API_TOKEN=your-token-here